# Copy to .env and adjust. Nothing here is required for DEMO MODE --
# the backend runs fully offline against local SQLite with these unset.

# --- Database (LIVE MODE) --------------------------------------------------
# Verified this session against a real local PostgreSQL 16 + PostGIS 3.4
# instance (see docs/UPGRADE_AUDIT.md) -- this is not an untested aspiration.
# DATABASE_URL=postgresql+psycopg2://indra:indra_dev_password@postgres:5432/indra

# --- Streaming / cache (LIVE MODE) -----------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
# Redis rate limiting verified this session against a real local Redis
# instance (security/auth.py falls back to in-memory if unreachable).
# REDIS_URL=redis://redis:6379/0

# --- Object storage (LIVE MODE) --------------------------------------------
# Not verified this session -- MinIO could not be installed/run in this
# sandbox (see docs/LIMITATIONS.md). storage.py's save_media() is the swap
# point; local disk is used until a real MinIO client is wired in there.
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=indra_minio
# MINIO_SECRET_KEY=indra_minio_secret
# MINIO_BUCKET=indra-media

# --- Admin auth abstraction --------------------------------------------------
ADMIN_TOKEN=demo-admin-token
# Off by default so Judge Mode / local demo needs no setup. Set to "true" to
# require the X-Admin-Token header (matching ADMIN_TOKEN) on verify/reject/
# escalate/severity/duplicate-mark/alert-acknowledge actions.
REQUIRE_ADMIN_TOKEN=false

# --- Role-based JWT auth (ADMIN / ANALYST / VIEWER) ------------------------
# Off by default, same reasoning as REQUIRE_ADMIN_TOKEN. When enabled, admin
# actions require a Bearer token from POST /api/auth/login with an ADMIN-
# role account; read-only endpoints stay open regardless.
REQUIRE_JWT_AUTH=false
JWT_SECRET=indra-demo-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=8
# Demo account credentials -- never hardcoded in source, always overridable.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=indra-admin-demo
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=indra-analyst-demo
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=indra-viewer-demo

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=1200

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=*

# --- Fusion / detection thresholds (tune without touching code) -----------
DUP_TEXT_SIM=0.55
DUP_RADIUS_KM=5.0
DUP_TIME_WINDOW_MIN=90
CLUSTER_EPS_KM=8.0
CLUSTER_MIN_SAMPLES=2
FUSION_MIN_CONFIDENCE=0.35
CRITICAL_REPORT_COUNT=40
HIGH_REPORT_COUNT=12
